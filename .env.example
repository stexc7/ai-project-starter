# Plantilla de variables de entorno.
#
# 1. Copia este archivo a `.env`
# 2. Rellena los valores reales
# 3. NUNCA commitees `.env` — está en .gitignore por una razón
#
# Los valores de aquí son FALSOS y están para documentar el formato.
# Documenta cada variable también en `.ai/STACK.md`.

# ── Aplicación ──
APP_NAME=mi-proyecto
APP_ENV=development          # development | staging | production
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug              # error | warn | info | debug

# ── Base de datos ──
DATABASE_URL=postgres://usuario:contrasena@localhost:5432/mi_proyecto_dev

# ── Autenticación ──
# Genera uno real con:  openssl rand -base64 32
JWT_SECRET=CAMBIAME-genera-un-secreto-aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Servicios externos ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ── Observabilidad ──
# SENTRY_DSN=

# ── Funcionalidades ──
FEATURE_CSV_EXPORT=true
