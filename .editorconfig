# https://editorconfig.org
# Formato consistente entre editores. Lo respetan VS Code, Visual Studio,
# JetBrains y la mayoría de editores modernos.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
# Dos espacios al final de línea son un salto de línea en Markdown.
trim_trailing_whitespace = false
max_line_length = off

[*.{py,rs}]
indent_size = 4

[*.{cs,vb}]
indent_size = 4
end_of_line = crlf

[*.{java,kt,kts,gradle}]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4
end_of_line = crlf

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[*.{bat,cmd}]
end_of_line = crlf
